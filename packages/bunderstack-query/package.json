    "@standardserver/core": "0.7.1",
    "@tanstack/query-core": "^5.101.1",
    "@tanstack/react-query": "^5.101.1",
    "@types/bun": "^1.3.14",
    "bunderstack": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "valibot": "1.4.2"
  },
  "peerDependencies": {
    "@orpc/client": "2.0.0-beta.26",
