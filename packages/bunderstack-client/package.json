{
  "name": "bunderstack-client",
  "version": "0.20.0",
  "description": "Framework-neutral typed client, realtime transport, and live views for Bunderstack.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rest": {
      "types": "./dist/rest.d.ts",
      "default": "./dist/rest.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "default": "./dist/solid.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "default": "./dist/svelte.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts bunderstack-client",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@orpc/client": "2.0.0-beta.26",
    "@orpc/server": "2.0.0-beta.26",
    "@standardserver/core": "0.7.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@orpc/client": "2.0.0-beta.26",
    "@orpc/server": "2.0.0-beta.26",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.0.0",
    "bunderstack": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "react": "^19.0.0",
    "solid-js": "2.0.0-rc.0",
    "typescript": "^5.8.0",
    "valibot": "1.4.2",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "solid-js": ">=2.0.0-rc.0",
    "typescript": ">=5",
    "vue": ">=3.5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
