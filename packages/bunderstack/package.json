    "backend",
    "better-auth",
    "bun",
    "crud",
    "drizzle",
    "framework",
    "orpc",
    "realtime",
    "typesafe"
  ],
  "homepage": "https://github.com/kirill-dev-pro/bunderstack#readme",
  "license": "MIT",
  "repository": {
