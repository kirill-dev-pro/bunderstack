{
  "name": "bunderstack",
  "version": "0.16.0",
  "description": "Batteries-included backend framework for Bun: type-safe oRPC APIs, auth, storage, realtime, jobs, email, and validated env from one config.",
  "keywords": [
    "backend",
    "better-auth",
    "bun",
    "crud",
    "drizzle",
    "framework",
    "orpc",
    "realtime",
    "typesafe"
  ],
  "homepage": "https://github.com/kirill-dev-pro/bunderstack#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirill-dev-pro/bunderstack.git",
    "directory": "packages/bunderstack"
  },
  "bin": {
    "bunderstack": "./src/cli.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./access": "./src/access.ts",
    "./database/bun-sql": "./src/database/bun-sql.ts",
    "./database/libsql": "./src/database/libsql.ts",
    "./database/pglite": "./src/database/pglite.ts",
    "./database/postgres-js": "./src/database/postgres-js.ts",
    "./provision": "./src/provision.ts",
    "./schema": "./src/schema-export.ts",
    "./schema/pg": "./src/schema-export-pg.ts",
    "./typeid": "./src/typeid.ts",
    "./typeid/pg": "./src/typeid-pg.ts",
    "./env": "./src/env.ts",
    "./blueprint": "./src/blueprint.ts",
    "./cron": "./src/cron.ts",
    "./email/smtp": "./src/email/smtp.ts",
    "./api": "./src/api/types.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "dev": "bun --hot ../../examples/standalone/server.ts",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "valibot": "1.4.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": ">=0.3.0",
    "@libsql/client": ">=0.14.0",
    "@orpc/openapi": "2.0.0-beta.26",
    "@orpc/bun": "2.0.0-beta.26",
    "@orpc/publisher": "2.0.0-beta.26",
    "@orpc/server": "2.0.0-beta.26",
    "@orpc/valibot": "2.0.0-beta.26",
    "@types/nodemailer": "^6",
    "better-auth": "^1.0.0",
    "drizzle-kit": "^0.30.0",
    "drizzle-orm": "^0.45.0",
    "drizzle-valibot": "0.4.2"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.3.0",
    "@libsql/client": ">=0.14.0",
    "@orpc/openapi": "2.0.0-beta.26",
    "@orpc/bun": "2.0.0-beta.26",
    "@orpc/publisher": "2.0.0-beta.26",
    "@orpc/server": "2.0.0-beta.26",
    "@orpc/valibot": "2.0.0-beta.26",
    "better-auth": "^1.0.0",
    "drizzle-kit": "^0.30.0",
    "drizzle-orm": "^0.45.0",
    "drizzle-valibot": "0.4.2",
    "nodemailer": ">=6 <10",
    "postgres": ">=3.4.0",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "@libsql/client": {
      "optional": true
    },
    "drizzle-kit": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
