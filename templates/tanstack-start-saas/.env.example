# Names and safe placeholders only. Real credentials stay in the environment.

# Database. Local development uses a file-backed libSQL database.
DATABASE_URL=file:./data.db

# Better Auth. Generate a unique secret per environment.
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Email. Without RESEND_API_KEY the console provider is used in development.
EMAIL_FROM=Relay <hello@example.com>
RESEND_API_KEY=

# Realtime. Required when the web and worker processes run separately,
# because the in-memory broker cannot cross process boundaries.
REDIS_URL=

# Browser-safe variables must use the PUBLIC_ prefix.
PUBLIC_APP_NAME=Relay
