# Names and safe placeholders only. Real credentials stay in the environment.

# Database. Local development uses a file-backed libSQL database.
DATABASE_URL=file:./data.db

# Better Auth. Generate a unique secret per environment.
AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Email. Locally every message is captured and printed to the console; on
# Bunderhost the Messaging tab chooses the provider and the sender. Set
# EMAIL_FROM only to override that sender.
EMAIL_FROM=

# Signs POST /api/webhooks/tasks (HMAC-SHA256 of the body, hex, in the
# X-Relay-Signature header as sha256=<hex>). Unset, the webhook refuses all.
TASKS_WEBHOOK_SECRET=

# Realtime. Required when the web and worker processes run separately,
# because the in-memory broker cannot cross process boundaries.
REDIS_URL=

# Browser-safe variables must use the PUBLIC_ prefix.
PUBLIC_APP_NAME=Relay
