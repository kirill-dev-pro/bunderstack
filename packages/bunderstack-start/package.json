{
  "name": "bunderstack-start",
  "version": "0.17.0-beta.7",
  "description": "TanStack Start integration for bunderstack: isomorphic fetch wiring, auth client, and query/sync setup for SSR apps.",
  "keywords": [
    "auth",
    "bun",
    "bunderstack",
    "react",
    "ssr",
    "tanstack-start"
  ],
  "homepage": "https://github.com/kirill-dev-pro/bunderstack#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirill-dev-pro/bunderstack.git",
    "directory": "packages/bunderstack-start"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth-client.d.ts",
      "default": "./dist/auth-client.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts bunderstack-start",
    "prepack": "bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "bunderstack-sync": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-start": "^1.168.26",
    "@types/bun": "^1.3.14",
    "better-auth": "^1.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-start": ">=1.0.0",
    "better-auth": "^1.0.0",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
