APP_URL=http://localhost:3007
AUTH_SECRET=replace-me-with-a-long-random-secret
DATABASE_URL=file:./data.db

# Optional AI Provider Configuration
# Without an API key, the example uses its deterministic local responder.
# Select `openai` for the existing OpenAI-compatible adapter or `iqdoc` for
# IQdoc's upstream medical agent.
AI_PROVIDER=openai

# Option 1: Hetzner Experiments AI (Default free tier model)
# Get a token at https://experiments.hetzner.com
AI_API_KEY=
AI_BASE_URL=https://inference.hetzner.com/api/v1
AI_MODEL=Qwen3.8-27B

# Option 2: DeepSeek
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat

# Option 3: OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini

# Option 4: IQdoc upstream agent
# IQdoc owns its medical retrieval and calculator actions. Bunderstack records
# their visible status/results and the answer draft durably.
# AI_PROVIDER=iqdoc
# IQDOC_API_KEY=...
# IQDOC_BASE_URL=https://your-iqdoc-endpoint.example/api/v1
# IQDOC_MODEL=assistant_auto

PUBLIC_APP_NAME=Agent Desk
