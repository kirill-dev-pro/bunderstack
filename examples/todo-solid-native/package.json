{
  "name": "bunderstack-example-todo-solid-native",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/provision.ts && bun --bun ./node_modules/vite/bin/vite.js --port 3008",
    "provision": "bun src/provision.ts",
    "gen": "bun scripts/generate-api.ts",
    "test": "bun test src/",
    "build": "bun --bun ./node_modules/vite/bin/vite.js build",
    "start": "bun src/provision.ts && bun .output/server/index.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@solidjs/web": "2.0.0-rc.0",
    "better-auth": "^1.0.0",
    "bunderstack": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "solid-js": "2.0.0-rc.0",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.28",
    "drizzle-kit": "^0.31.0",
    "nitro": "^3.0.260610-beta",
    "typescript": "^5.0.0",
    "vite": "^8.0.0"
  }
}
